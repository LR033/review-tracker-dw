# Copy this file to `.streamlit/secrets.toml` and fill in your keys.
# secrets.toml is gitignored so the keys never get committed.
#
# ANTHROPIC_API_KEY — used by dashboard/app.py for the "Draft reply with Claude"
# and "Analyze" features. Without it the dashboard still runs; only the
# Claude-powered features are disabled.
ANTHROPIC_API_KEY = "sk-ant-..."

# TOURDASH_API_KEY — TourDash booking API key. The scraper
# (scrapers/tourdash_scraper.py) reads it from the environment; keep a copy
# here so the dashboard environment also carries it. Mirror it as a GitHub
# Actions secret named TOURDASH_API_KEY so the daily scrape can pull bookings.
TOURDASH_API_KEY = "td_..."

# ---------------------------------------------------------------------------
# Private Google Sheet — persists the dashboard's internal notes AND
# "mark as responded" records (see dashboard/gsheet_store.py). REQUIRED on
# Streamlit Cloud: its filesystem is ephemeral, so notes/responses written to
# data/*.csv are lost on every restart, and this repo is public so internal
# notes must not be committed to it. When these two sections are absent the app
# falls back to the local CSVs (fine for local dev; do NOT rely on it on Cloud).
#
# Setup: create a GCP service account (enable Sheets + Drive APIs), download its
# JSON key, create a Sheet, and share it with the service account's client_email
# as Editor. Then paste the JSON key fields below and the sheet id. The "notes"
# and "responses" tabs are created automatically on first write.
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "name@your-project.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
#
# [gsheet]
# spreadsheet_id = "the id from the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit"
